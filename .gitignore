# Build and tooling artifacts that do not belong in a WordPress plugin
.next/
node_modules/
vendor/
*.log
lintout.json
uv.txt

# Packaged releases
*.zip

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Local agent state. The whole directory: launch.json and settings.local.json
# both carry absolute paths and the names of other private projects, which
# have no business in a public repository.
.claude/

# Portable PHP and PHPUnit, dropped in by tools/run-tests.ps1
.php/
phpunit.phar

# Release archives built by tools/build-zip.py
dist/
phpunit.out
